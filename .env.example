# Trace server the site talks to. The browser loads the SDK from TRACE_ENDPOINT, so it must be reachable publicly.
TRACE_ENDPOINT=http://localhost:8080
# Server-side calls (verify, device graph) can use an internal address; defaults to TRACE_ENDPOINT.
# TRACE_API_URL=http://trace-server:8080
# Keys of a project created for the site. Add the site's origin (e.g. https://trace.example.com) to the public key.
TRACE_PUBLIC_KEY=pk_...
TRACE_SECRET_KEY=sk_...
# Link targets
NEXT_PUBLIC_GITHUB_URL=https://github.com/OWNER/trace
